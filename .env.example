# =============================================================================
# Deep Research AI - Example Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values:
#
#   Copy-Item .env.example .env
#
# NEVER commit your real `.env` file. Only this example file is tracked by Git.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM provider (OpenAI-compatible)
# -----------------------------------------------------------------------------
# API key for your OpenAI-compatible provider. Required for real research runs.
OPENAI_API_KEY=

# Chat model used by all agents. Examples: gpt-4o-mini, gpt-4o, gpt-4.1-mini
OPENAI_MODEL=gpt-4o-mini

# Optional: override the base URL to use an OpenAI-compatible gateway
# (e.g. Azure OpenAI, OpenRouter, Together, a local vLLM/Ollama server).
# Leave blank to use the official OpenAI endpoint.
OPENAI_BASE_URL=

# Sampling temperature for agent calls (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Web search provider
# -----------------------------------------------------------------------------
# Tavily API key. Required for real web research. Get one at https://tavily.com
TAVILY_API_KEY=

# Maximum number of results to request per search query (1-20)
SEARCH_MAX_RESULTS=5

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite (default, zero-config local development):
DATABASE_URL=sqlite:///./data/research.db
#
# PostgreSQL (production / docker-compose):
# DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
#
# When running via docker-compose the host is `db`:
# DATABASE_URL=postgresql+psycopg://research:research@db:5432/research

# -----------------------------------------------------------------------------
# Workflow limits, retries, and timeouts
# -----------------------------------------------------------------------------
# Maximum number of focused research tasks the coordinator may create
MAX_RESEARCH_TASKS=5

# Maximum number of search requests allowed for the whole run
MAX_SEARCH_REQUESTS_PER_RUN=25

# Maximum number of web pages fetched for the whole run
MAX_PAGE_FETCHES_PER_RUN=30

# How many extra research loops are allowed when evidence is insufficient
MAX_RESEARCH_RETRIES=1

# How many times the reviewer may send the report back for correction
MAX_REVIEW_RETRIES=1

# Per-request network timeout (seconds) for search + page fetches
REQUEST_TIMEOUT_SECONDS=30

# Overall wall-clock budget for a single research run (seconds)
RUN_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Input guard rails
# -----------------------------------------------------------------------------
# Maximum allowed length of the user's research question
MAX_QUESTION_LENGTH=1000

# Minimum allowed length of the user's research question
MIN_QUESTION_LENGTH=10

# -----------------------------------------------------------------------------
# Backend server
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of allowed CORS origins for the frontend
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Frontend -> backend base URL (used by the Streamlit app)
BACKEND_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# -----------------------------------------------------------------------------
# LangSmith tracing (optional)
# -----------------------------------------------------------------------------
# Set to true only after providing a valid LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-research-ai

# LangChain also reads these standard variables:
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=deep-research-ai
